{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mocars-marketplace",
	"main": "cloudflare/worker.js",
	"compatibility_date": "2026-11-04",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"ADMIN_EMAIL": "Brandonmambeke@gmail.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mocars-db",
			"database_id": "86a8cda9-124f-41b0-9dc7-ebc3118e8bd4"
		}
	]
}