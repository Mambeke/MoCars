{
  "name": "mocars-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "test:acceptance": "node qa/acceptance.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "cloudflare:db:migrate": "wrangler d1 execute mocars-db --remote --file=cloudflare/schema.sql"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/montserrat": "^5.2.6",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "vite": "^6.0.7",
    "wrangler": "^4.60.0"
  }
}
